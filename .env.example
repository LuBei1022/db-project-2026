# 把本文件复制为 .env 并填入真实值。.env 不要提交到 git。

# ===== DeepSeek 大模型 =====
LLM_API_KEY=在这里填你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash


# ===== SQL Server（真网站数据库，默认值来自 Web.config）=====
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=123456
SQLSERVER_DB=manage_db_final

# ===== 向量库 / 检索 =====
EMBEDDING_MODEL_NAME=moka-ai/m3e-base
CHROMA_PERSIST_DIR=./chroma_db
RAG_TOP_K=4

# ===== PDF 文件根目录 =====
# LiteratureFile.file_path 存的是相对 A_UpLoad/upload_file/ 的路径(按日期分文件夹)，
# 所以这里要填到 upload_file 这一层。把下面换成你电脑上的真实绝对路径：
# 例: /Users/你的用户名/Desktop/db-project-2026-main/网站源码/Web/A_UpLoad/upload_file
PDF_BASE_DIR=
